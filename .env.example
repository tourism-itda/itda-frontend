# 로컬 개발: vite.config.ts의 /api 프록시가 localhost:8080으로 전달하므로 비워둡니다.
# 배포 환경 등 프록시 없이 직접 호출할 때만 백엔드 origin을 넣으세요 (예: https://api.example.com).
VITE_API_URL=

# 카카오 로그인: 프론트가 카카오 인가 페이지로 직접 이동한 뒤, 돌아온 code를
# POST /api/auth/kakao로 넘겨 로그인을 완료한다(AuthController.kakaoLogin, lib/auth.ts loginWithKakao).
VITE_KAKAO_CLIENT_ID=
# 로컬: http://localhost:5173/oauth/kakao/callback
# 배포: https://itda-frontend-peach.vercel.app/oauth/kakao/callback
#
# 주의: itda-backend(참고용, 수정 불가)의 kakao.redirect-uri(application.yml)는
# "https://itda-frontend-peach.vercel.app/oauth/kakao/callback" 하나로 고정돼 있고,
# 토큰 교환(KakaoAuthClient.getAccessToken) 시 요청 파라미터가 아니라 이 고정값을 그대로 쓴다.
# 카카오 OAuth는 인가 요청과 토큰 교환의 redirect_uri가 정확히 일치해야 하므로, 로컬에서
# redirect_uri를 localhost로 바꿔 인가까지는 받아도 백엔드가 배포 URI로 토큰을 교환하려 하면서
# redirect_uri mismatch로 실패한다. 로컬에서 로그인까지 끝까지 검증하려면 백엔드가 요청받은
# redirect_uri를 그대로 쓰도록 바뀌거나, 로컬에서도 배포용 redirect_uri를 써야 한다(카카오 콘솔에
# 로컬 도메인이 리다이렉트 URI로 등록돼 있어야 함). 프론트 쪽에서 고칠 수 있는 부분은 아니다.
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback
