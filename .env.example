# 로컬 개발: vite.config.ts의 /api 프록시가 localhost:8080으로 전달하므로 비워둡니다.
# 배포 환경 등 프록시 없이 직접 호출할 때만 백엔드 origin을 넣으세요 (예: https://api.example.com).
VITE_API_URL=

# 카카오 로그인 콜백 경로. itda-backend 기준 기본값은 /api/auth/kakao/callback (GET, ?code=...).
# 백엔드 라우트가 바뀌면 이 값만 바꾸면 됩니다.
VITE_KAKAO_CALLBACK_PATH=/api/auth/kakao/callback
